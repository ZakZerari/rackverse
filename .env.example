# Mubit (OpenAI-compatible proxy). Every LLM call in this app goes through Mubit — see src/lib/llm.ts.
MUBIT_API_KEY=

# Measured on this account (see MUBIT_NOTES.md "Model choice"):
#   gemini-3.5-flash-lite  ~2.2s  <- default; fastest AND most reliable here
#   gemini-3.6-flash       ~7.5s  (intermittent 503 "high demand")
#   gemini-3.8-flash     ~105s    <- throttled to uselessness on this tier, do not use
MUBIT_MODEL=gemini-3.5-flash-lite

# Optional. Gemini 3.x has thinking on by default; "none" trims it where supported.
# Leave unset for the model default — flash-lite already defaults to minimal thinking.
# MUBIT_REASONING_EFFORT=none
