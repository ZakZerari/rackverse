# Mubit (OpenAI-compatible proxy). Every LLM call in this app goes through Mubit — see src/lib/llm.ts.
MUBIT_API_KEY=

# Production task model is pinned in src/lib/llm.ts. Changing it starts new
# Mubit tasks for every agent; use pick-model only for unrecorded diagnostics.
# Measured on this account (see MUBIT_NOTES.md "Model choice"):
#   On the free tier:
#     gemini-3.5-flash-lite  ~2.2s   <- was the default there; fastest and most reliable
#     gemini-3.6-flash       ~7.5s   (intermittent 503 "high demand")
#     gemini-3.8-flash     ~105s     <- throttled to uselessness on that tier
#   Re-measured after billing was enabled on the Gemini project (same real
#   Architect workload, 3 seeds):
#     gemini-3.5-flash-lite  ~2.1s   3/3 parsed, 1/3 valid first try
#     gemini-3.6-flash      ~13.7s   3/3 parsed, 3/3 valid first try
#     gemini-3.8-flash      ~18.3s   3/3 parsed, 3/3 valid first try  <- current default
# Billing turned 3.8-flash from unusable into ~9x slower than flash-lite but
# reliable — pinned deliberately for a stronger base model to train
# adapters on, at that known latency cost. Re-run `npm run pick-model` before
# trusting these numbers again; they're a point-in-time measurement, not a
# guarantee.
MUBIT_MODEL=gemini-3.8-flash

# Optional. Gemini 3.x has thinking on by default; "none" trims it where supported.
# MUBIT_REASONING_EFFORT=none
